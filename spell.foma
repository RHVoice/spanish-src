source include/norm/nspell.foma

define SpellLetter RegularLetter | NormalizeCharactersSpell ;

define Whitespace 
tab:tab | 
nl:[línea nueva] | 
cr:[retorno de línea] | 
sp:espacio | 
nbsp:[espacio sin descanso] ; 

source include/textproc/symbols.foma

regex 
SpellLetter|SpellDigit | Whitespace | Symbol ; 
